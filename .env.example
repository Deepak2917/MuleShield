# Generate a fresh 32-byte key for this environment; never commit the real .env file.
# PowerShell: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MULESHIELD_ENCRYPTION_KEY=replace_with_64_hex_characters

# Optional local configuration
PORT=3001
HOST=127.0.0.1
SESSION_HOURS=8
# MULESHIELD_DB_PATH=F:\MuleShield\data\muleshield.sqlite

# Set NODE_ENV=production only behind HTTPS; cookies then require Secure.
# If a production reverse proxy needs a non-loopback bind, set HOST accordingly
# and restrict API access at the network boundary.
# NODE_ENV=production
# APP_ORIGIN=https://muleshield.example.org
